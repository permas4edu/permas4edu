NEW

INPUT
    READ PERMAS FILE = problem_04.dat
    READ PERMAS FILE = problem_04_opt.dat
RETURN

TASK LOOPS = 50
EXEC
    ACT SIT = STEP_1
    STATIC
EXPORT
    ITEM MODL NEWCOOR
    GO PERMAS BINARY FILE = 'statics_%.3(tloop)'
EXEC
    ACT SIT = OPT
    OPTIM TOLOBJ = 1.E-5  METHOD = SQP ! ACP
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = OHIS
    ITEM XYDATA TYPE = CHIS
    ITEM XYDATA TYPE = RHIS
    ITEM XYDATA TYPE = DHIS
    GO PERMAS BINARY FILE = 'problem_04_xy_%.3(tloop)'
    ITEM CLEAR
    ITEM COOR MOD
    GO PERMAS BINARY FILE= 'coor_mod_%.3(tloop)'
TASK END
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = SRHIS
    ITEM XYDATA TYPE = DHIS
    GO PERMAS BINARY FILE = monitoring
STOP
