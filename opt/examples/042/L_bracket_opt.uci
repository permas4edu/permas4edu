NEW

INPUT
    READ PERMAS FILE = L_bracket.dat
    READ PERMAS FILE = L_bracket_opt.dat
RETURN

TASK LOOPS = 50
EXEC
    ACT SIT = STEP_1
    STATIC
    ACT SIT = OPT
    OPTIM METHOD = ACP
EXPORT
    ITEM CLEAR
    ITEM COOR MOD
    GO PERMAS BINARY FILE = 'coor_mod_%.3(tloop)'
    ITEM CLEAR 
    ITEM NORMAL CHANGE
    GO PERMAS BINARY FILE = 'normal_change_%.3(tloop)'
    ITEM CLEAR
    ITEM XYDATA TYPE = OHIS
    ITEM XYDATA TYPE = CHIS
    ITEM XYDATA TYPE = RHIS
    GO PERMAS BINARY FILE = 'opt_xy_%.3(tloop)'
TASK END
STOP