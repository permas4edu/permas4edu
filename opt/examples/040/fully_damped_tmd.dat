$DEFVAR F TYPE = REAL LIST = 1.0  ! Excitation
$DEFVAR MU TYPE = REAL LIST = 0.1 ! Mass ratio
$DEFVAR OMEGA_1 TYPE = REAL LIST = 2.0
$DEFVAR OMEGA_2 TYPE = REAL LIST = 2.0
$DEFVAR XI_1 TYPE = REAL LIST = 0.1
$DEFVAR XI_2 TYPE = REAL LIST = 0.1
 
$ENTER COMPONENT NAME = DFLT_COMP

    $SITUATION NAME = STEP_1
       DFLT_COMP  SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1
    $END SITUATION
!
    $SITUATION NAME = STEP_2  PARENT = STEP_1
       DFLT_COMP  SYSTEM = S_STEP_1
    $END SITUATION
!
    $SITUATION NAME = STEP_3  PARENT = STEP_1
       DFLT_COMP  SYSTEM = S_STEP_1  LOADING = L_STEP_2  RESULTS = R_STEP_2
    $END SITUATION
  
    $STRUCTURE
!
        $NSET NAME = GROUND
          100
!
        $NSET NAME = F
          101
!
        $NSET NAME = FREE RULE = BOOLEAN
          ALL_NODES AND NOT GROUND  
! 
        $NODE NSET = ALL_NODES
          100  0.0  0.0  0.0
          101  1.0  0.0  0.0
          102  2.0  0.0  0.0
!
       $ELEMENT TYPE = MASS3 ESET = M1
            1  101
       $ELEMENT TYPE = MASS3 ESET = M2
            2  102
!
       $ELEMENT TYPE = SPRING1 ESET = K1
            3  100  101
       $ELEMENT TYPE = SPRING1 ESET = K2
            4  101  102
!
       $ELEMENT TYPE = DAMP1 ESET = C1
            5  100  101
       $ELEMENT TYPE = DAMP1 ESET = C2
            6  101  102 
  
    $END STRUCTURE

    $SYSTEM NAME = S_STEP_1

        $GEODAT MASS CONT = MASS
           GD_M1   1.0
           GD_M2   MU(1) ! mass ratio
!
!       \mu = 0.1  \Omega_1 = \Omega_2 = 2.0
!       \xi_1 = 0.1
!
        $GEODAT SPRING CONT = STIFF
           GD_K1   4.0    ! \Omega_1^2 
           GD_K2   0.4    ! \Omega_2^2 \mu 

        $GEODAT DAMPER CONT = DAMP
           GD_C1  0.4  !  2\xi_1 \Omega_1
           GD_C2  0.02 !  2\xi_2 \Omega_2 \mu

        $ELPROP
           M1  GEODAT = GD_M1
           M2  GEODAT = GD_M2
           K1  GEODAT = GD_K1
           K2  GEODAT = GD_K2
           C1  GEODAT = GD_C1
           C2  GEODAT = GD_C2
  
    $END SYSTEM

    $CONSTRAINTS NAME = C_STEP_1

        $SUPPRESS DOFS = 2,3
          ALL_NODES

        $SUPPRESS DOFS = 1
          GROUND

    $END CONSTRAINTS

    $LOADING NAME = L_STEP_2

       $CONLOAD LPAT = 1
         F 1: 1.0

       $FREQLOAD
          LPAT = 1 TYPE = COSINE
  
    $END LOADING

    $RESULTS NAME = R_STEP_2

       $FREQUENCY PRIMARY = EQUI
          0.0 1.0 0.005
          
    $END RESULTS

$EXIT COMPONENT
$FIN
