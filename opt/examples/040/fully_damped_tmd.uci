NEW

INPUT
    READ PERMAS FILE = fully_damped_tmd.dat
    READ PERMAS FILE = fully_damped_tmd_opt.dat
RETURN

TASK LOOPS = 100
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 2
!EXPORT
!    ITEM MODL
!    GO PERMAS BINARY FILE = normal_modes
EXEC
    MODAL COMPLEX SITUATION = STEP_2
    ACT SIT = STEP_2
EXEC
    MODAL FREQUENCY SITUATION = STEP_3
    ACT SIT = STEP_3
SELECT
    ACTIVE NSET = F
    XYDATA ITEM DISP RESULT = FRF DCOMP = 1
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = FRF
    GO PERMAS BINARY FILE = 'frf_%.3(tloop)'
    GO SPREADSHEET FILE = 'frf_%.3(tloop)'
EXEC
    ACT SIT = OPT
    OPTIM METHOD = ACP 
TASK END
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = OHIS  ! Objective history
    ITEM XYDATA TYPE = CHIS  ! Constraint history
    ITEM XYDATA TYPE = RHIS  ! Relative constraint history
    ITEM XYDATA TYPE = DHIS  ! Design variable history
    GO PERMAS BINARY FILE = opt_xy
    ITEM CLEAR
    ITEM XYDATA TYPE = SRHIS ! additional result items 
    GO PERMAS BINARY FILE = monitoring
    GO SPREADSHEET FILE = monitoring
USER
    CALL TOOL6 P1 = 'pyINTES fully_damped_tmd.py'
RETURN
USER
    CALL TOOL6 P1 = 'pyINTES fully_damped_tmd_anim.py'
RETURN
STOP
