NEW

INPUT
    READ PERMAS FILE = case_3.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 20
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
EXEC
    ACTIVE NSET = RESPONSE
    MODAL TIMEHISTORY SITUATION = STEP_2 &
                      LOOPS = 500 &
                      DELTAT = 1.E-3 &
                      TSTART = 0.0 &
                      RESPONSE = TOTAL &
                      OUTPUT = ALL &
                      PRIMRES = REDUCED &  
                      SOLV = NEWMARK ! HHT, TWOSTEP  
    ACT SIT = STEP_2
SELECT
    ACTIVE NSET = RESPONSE
    XYDATA ITEM DISP RESULT = U DCOMP = 1
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = U
    GO PERMAS BINARY FILE = u
    GO SPREADSHEET FILE = u
TASK END
STOP  
