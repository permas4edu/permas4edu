NEW

INPUT
    READ PERMAS FILE = el_bakari.dat
    READ PERMAS FILE = el_bakari_sampling.dat
RETURN

TASK LOOPS = 3
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 10
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = 'normal_modes_%.3(tloop)'
EXEC
    ACTIVE NSET = F
    MODAL TIMEHISTORY SITUATION = STEP_2 &
                      LOOPS = 500 &
                      DELTAT = 0.004 &
                      TSTART = 0.0 &
                      RESPONSE = ELASTIC &
                      OUTPUT = ALL &
                      PRIMRES = REDUCED &
                      SOLV = NEWMARK 
SELECT
    ACTIVE NSET = F
    XYDATA ITEM DISP RESULT = U   DCOMP = 3
    XYDATA ITEM VELO RESULT = UP  DCOMP = 3
    XYDATA ITEM ACCE RESULT = UPP DCOMP = 3
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = U 
    GO SPREADSHEET FILE = 'u_%.3(tloop)'
    ITEM CLEAR
    ITEM XYDATA TYPE = VELO NAME = UP 
    GO SPREADSHEET FILE = 'up_%.3(tloop)'
    ITEM CLEAR
    ITEM XYDATA TYPE = ACCE NAME = UPP 
    GO SPREADSHEET FILE = 'upp_%.3(tloop)'
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = U
    ITEM XYDATA TYPE = VELO NAME = UP
    ITEM XYDATA TYPE = ACCE NAME = UPP
    GO PERMAS BINARY FILE = 'response_%.3(tloop)'
EXEC
    ACT SIT = SAMPLING
    SAMPLING
TASK END
STOP