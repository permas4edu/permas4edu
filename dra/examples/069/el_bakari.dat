   $SYSTEM  NAME = S_STEP_1
!
      $ADDMODES SOURCE = LOAD
        LPAT = ALL
!
      $MODDAMP TYPE = RATIO KIND = FUNCTION
         0.02
!
!*E* 251/0541 Definition of modal damping values via function not possible for
!             Rigid body modes / singular modes.
!
      $MODDAMP TYPE = RBMODE KIND = DISCRETE
         1, 0.02
         2, 0.02   
!
      $GEODAT BEAM      CONT = SECTTYPE SECTDIM
       GD_BEAM               5
         &        :  2.000000E-02  2.000000E-02
      $GEODAT SPRING    CONT = STIFF
       GD_K          1.000000E+00
!
      $ELPROP
       BEAM          GEODAT = GD_BEAM       MATERIAL = MAT_BEAM
       K             GEODAT = GD_K
!
   $END SYSTEM
