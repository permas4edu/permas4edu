$ENTER COMPONENT  NAME = DFLT_COMP  DOFTYPE = DISP MATH
!------
   $SITUATION  NAME = SAMPLING  CONNECTED = STEP_1 STEP_2
      DFLT_COMP  CONSTRAINTS = C_STEP_1  SYSTEM = S_STEP_1 RESULTS = R_SAMPLING
   $END SITUATION
!
   $STRUCTURE
!
      $DELEMENT TYPE = DSPRING
                1          1: K
!
   $END STRUCTURE
!------
   $SYSTEM  NAME = S_STEP_1
!
      $DVGPAR SPRING  NAME = GD_K  DEID = 1
      STIFF          1:          1
!
   $END SYSTEM
!------
   $RESULTS NAME = R_SAMPLING
!
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_1  MODE = 1
      F_1
!
      $VPARVAL  TYPE = DESVAR
                1  1.000000E+00  1.000000E+01  1.000000E+02
!
      $RESEXT  ITEM
      F_1 : F_1          1
!
   $END RESULTS
!------
$EXIT COMPONENT
