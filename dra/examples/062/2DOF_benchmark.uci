NEW

INPUT
    READ PERMAS FILE = 2DOF_benchmark.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 2
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
EXEC
    ACTIVE NSET = FREE
    MODAL TIMEHISTORY SITUATION = STEP_2 &
                       LOOPS = 300 &
                       DELTAT = 4.E-3 &
                       TSTART = 0.0 &
                       RESPONSE = TOTAL &
                       OUTPUT = ALL &
                       PRIMRES = REDUCED &
                       SOLV = NEWMARK  
    ACT SIT = STEP_2
SELECT
    ACTIVE NSET = FREE
    XYDATA ITEM DISP RESULT = U   DCOMP = 1
    XYDATA ITEM VELO RESULT = UP  DCOMP = 1
    XYDATA ITEM ACCE RESULT = UPP DCOMP = 1
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = U
    ITEM XYDATA TYPE = VELO NAME = UP
    ITEM XYDATA TYPE = ACCE NAME = UPP
    GO PERMAS BINARY FILE = modal_response
    GO SPREADSHEET FILE = modal_response
TASK END
STOP
