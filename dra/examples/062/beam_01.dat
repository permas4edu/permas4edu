$ENTER COMPONENT  NAME = DFLT_COMP  DOFTYPE = DISP MATH
!------
   $SITUATION  NAME = STEP_1
      DFLT_COMP  CONSTRAINTS = C_STEP_1  SYSTEM = S_STEP_1
   $END SITUATION
!
   $SITUATION  NAME = STEP_2  PARENT = STEP_1
      DFLT_COMP  SYSTEM = S_STEP_1  
   $END SITUATION

   $SITUATION  NAME = STEP_3  PARENT = STEP_1
      DFLT_COMP  SYSTEM = S_STEP_1  LOADING = L_STEP_3 
   $END SITUATION

!
   $STRUCTURE
!
      $ELEMENT TYPE = BECOS
                1          1          3
                2          3          4
                3          4          5
                4          5          6
                5          6          7
                6          7          8
                7          8          9
                8          9          2
!
      $RSYS CART  FORM = ZX
                1  0.000000E+00  0.000000E+00  0.000000E+00 :  1.000000E+02  0.000000E+00  0.000000E+00 :  0.000000E+00  0.000000E+00 -1.000000E+02
!
      $ELSYS RSYS
       BEAM          RSYS =          1  AXES =  1,  2
!
      $NSET NAME = ACCELEROMETER
                2          4          7
      $NSET NAME = BEAM
                1          2          3          4          5          6          7          8          9
      $NSET NAME = CLAMPED
                1
      $NSET NAME = F
                7
      $NSET NAME = FREE
                2          3          4          5          6          7          8          9
      $ESET NAME = BEAM
                1          2          3          4          5          6          7          8
      $ESET NAME = LINE1
                1          2          3          4          5          6          7          8
!
      $COOR  NSET = ALL_NODES
                1  0.000000E+00  0.000000E+00  0.000000E+00
                2  1.000000E+00  0.000000E+00  0.000000E+00
                3  1.250000E-01  0.000000E+00  0.000000E+00
                4  2.500000E-01  0.000000E+00  0.000000E+00
                5  3.750000E-01  0.000000E+00  0.000000E+00
                6  5.000000E-01  0.000000E+00  0.000000E+00
                7  6.250000E-01  0.000000E+00  0.000000E+00
                8  7.500000E-01  0.000000E+00  0.000000E+00
                9  8.750000E-01  0.000000E+00  0.000000E+00
!
      $PART  NAME = LINE1
       LINE1
!
   $END STRUCTURE
!------
   $SYSTEM  NAME = S_STEP_1
!
     $COMPDAMP
!    Damping ratio xi = 0.010
!    Standard approach
          ALPHA = 1.331262e-04 BETA = 3.565545e-01
!
      $GEODAT BEAM      CONT = SECTTYPE SECTDIM
       GD_BEAM               5
         &        :  3.000000E-02  4.000000E-03
!
      $ELPROP
       BEAM          GEODAT = GD_BEAM       MATERIAL = ALUMINUM
!
   $END SYSTEM
!------
   $CONSTRAINTS  NAME = C_STEP_1
!
      $SUPPRESS  DOFS = 1,2,3,4,5,6  DOFTYPE = DISP
       CLAMPED
      $SUPPRESS  DOFS = 1,3,4,5  DOFTYPE = DISP
       FREE
!
   $END CONSTRAINTS
!------
   $LOADING  NAME = L_STEP_3
!
      $CONLOAD  LPAT = 1  DOFTYPE = DISP
       F            2:  1.000000E+00
!
      $TRANSLOAD
         LPAT = 1
!
   $END LOADING
!------
$EXIT COMPONENT
!------------------------------------
$ENTER MATERIAL
!------
   $MATERIAL  NAME = ALUMINUM  TYPE = ISO
!
      $ELASTIC  GENERAL  INPUT = DATA
        7.000000E+10  0.000000E+00
!
      $DENSITY  GENERAL  INPUT = DATA
        2.700000E+03
!
   $END MATERIAL
!------
$EXIT MATERIAL
!------------------------------------
$FIN
