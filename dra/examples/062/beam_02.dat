   $END STRUCTURE
!------
   $SYSTEM  NAME = S_STEP_1
!
      $MODDAMP TYPE = RATIO KIND = FUNCTION
         1.5E-02
!
      $GEODAT BEAM      CONT = SECTTYPE SECTDIM
       GD_BEAM               5
         &        :  3.133400E-02  7.021000E-03
!
      $ELPROP
       BEAM          GEODAT = GD_BEAM       MATERIAL = ALUMINUM
!
   $END SYSTEM
!------
   $CONSTRAINTS  NAME = C_STEP_1
!
      $SUPPRESS  DOFS = 1,2,3,4,5,6  DOFTYPE = DISP
       CLAMPED

!      $SUPPRESS DOFS = 1,3,4,5
!       FREE
      $SUPPRESS DOFS = 1,2,4,6
       FREE
!
   $END CONSTRAINTS
!------
   $LOADING  NAME = L_STEP_3
!
      $CONLOAD LPAT = 1
        F1 3: 1.0
      $CONLOAD LPAT = 2
        F2 3: 1.0

      $TRANSLOAD
        LPAT = 1
        LPAT = 2
!
   $END LOADING
