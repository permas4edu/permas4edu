$ENTER COMPONENT NAME = DFLT_COMP

   $SITUATION NAME = STEP_1
       DFLT_COMP SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1
   $END SITUATION
!
   $SITUATION NAME = STEP_2  PARENT = STEP_1
       DFLT_COMP SYSTEM = S_STEP_1  LOADING = L_STEP_2
   $END SITUATION

   $STRUCTURE
 
       $NODE NSET = ALL_NODES
          100  0.0  0.0  0.0
          101  1.0  0.0  0.0
          102  2.0  0.0  0.0
          200  3.0  0.0  0.0

       $ELEMENT TYPE = MASS3 ESET = M1
            1  101
       $ELEMENT TYPE = MASS3 ESET = M2
            2  102

       $ELEMENT TYPE = SPRING1 ESET = K1
            3  100  101
       $ELEMENT TYPE = SPRING1 ESET = K2
            4  101  102

       $ELEMENT TYPE = DAMP1 ESET = C1
            5  100  101
       $ELEMENT TYPE = DAMP1 ESET = C2
            6  101  102

       $ELEMENT TYPE = SPRING1 ESET = K3
            7  102  200
       $ELEMENT TYPE = DAMP1 ESET = C3
            8  102  200
  
       $NSET NAME = GROUND
            100 200
 
       $NSET NAME = FREE RULE = BOOLEAN
           ALL_NODES AND NOT GROUND

    $END STRUCTURE
 
    $SYSTEM NAME = S_STEP_1

       $GEODAT MASS CONT = MASS
          GD_M1  1.0
          GD_M2  0.9

       $GEODAT SPRING CONT = STIFF
          GD_K1 1200.0
          GD_K2  800.0
          GD_K3 1000.0
  
       $GEODAT DAMPER CONT = DAMP
          GD_C1    4.0
          GD_C2    2.5
          GD_C3    3.0

       $ELPROP
           M1  GEODAT = GD_M1
           M2  GEODAT = GD_M2
           K1  GEODAT = GD_K1
           K2  GEODAT = GD_K2
           C1  GEODAT = GD_C1
           C2  GEODAT = GD_C2
           K3  GEODAT = GD_K3
           C3  GEODAT = GD_C3
  
    $END SYSTEM 
  
    $CONSTRAINTS NAME = C_STEP_1

        $SUPPRESS DOFS = 2,3
           ALL_NODES

        $SUPPRESS DOFS = 1
           GROUND

    $END CONSTRAINTS

    $LOADING NAME = L_STEP_2

        $CONLOAD LPAT = 1
           101  1: 1.0

        $TRANSLOAD
           LPAT = 1 FUNCTION = EXCITATION
 
    $END LOADING

$EXIT COMPONENT
!
$ENTER FUNCTION

    $FUNCTION TABLE LABEL = EXCITATION INTERPOLATE = SMOOTH ! SPLINE
        $CSVINCLUDE CFORM = '$2 : $1' ROWS = 2 FILE = "force_on_second_mass_true_and_estimates.csv"

$EXIT FUNCTION
!
$FIN
