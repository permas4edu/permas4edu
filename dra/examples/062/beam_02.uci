NEW

INPUT
   READ PERMAS FILE = beam_02.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 10
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt 
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
EXEC
    MODAL COMPLEX SITUATION = STEP_2
    ACT SIT = STEP_2
PRINT
    PORT RES REPLACE FILE = complex_frequencies.txt
    DATA OBJECT CVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL 
    GO PERMAS BINARY FILE = complex_modes
EXEC
    ACTIVE NSET = ACCELEROMETER
    MODAL TIMEHISTORY SITUATION = STEP_3 &
                      LOOPS = 120 &
                      DELTAT =  1.5E-3 &
                      TSTART = 0.0 &
                      RESPONSE = TOTAL &
                      OUTPUT = ALL &
                      PRIMRES = REDUCED &
                      SOLV = NEWMARK 
    ACT SIT = STEP_3
SELECT
    ACTIVE NSET = ACCELEROMETER
    XYDATA ITEM DISP RESULT = U    DCOMP = 3
    XYDATA ITEM VELO RESULT = UP   DCOMP = 3
    XYDATA ITEM ACCE RESULT = UPP  DCOMP = 3
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = U
    ITEM XYDATA TYPE = VELO NAME = UP
    ITEM XYDATA TYPE = ACCE NAME = UPP
    GO PERMAS BINARY FILE = modal_response  ! hdf export
    GO SPREADSHEET FILE = modal_response ! csv export
TASK END
STOP
  