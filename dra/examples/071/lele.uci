NEW

INPUT
    READ PERMAS FILE = lele.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 5
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
EXEC
    MODAL TIMEHISTORY SITUATION = STEP_2 &
                      LOOPS = 1000 &
                      DELTAT = 0.001 &
                      TSTART = 0.0 &
                      RESPONSE = TOTAL &
                      OUTPUT = ALL &
                      SOLV = NEWMARK 
SELECT
    ACTIVE NSET = FREE
    XYDATA ITEM DISP RESULT = U DCOMP = 1
EXPORT
    ITEM CLEAR 
    ITEM XYDATA TYPE = DISP NAME = U
    GO PERMAS BINARY FILE = u
    GO SPREADSHEET FILE = u
TASK END
STOP        