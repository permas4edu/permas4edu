$ENTER COMPONENT NAME = DFLT_COMP 

    $SITUATION NAME = STEP_1
       DFLT_COMP SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1
    $END SITUATION

    $SITUATION NAME = STEP_2 PARENT = STEP_1
       DFLT_COMP SYSTEM = S_STEP_1  LOADING = L_STEP_2  
    $END SITUATION
   
    $STRUCTURE

        $NSET NAME = GROUND 
           100

        $NSET NAME = FREE RULE = BOOLEAN
           ALL_NODES AND NOT GROUND
 
        $NODE NSET = ALL_NODES
           100  0.0  0.0  0.0  
           101  1.0  0.0  0.0
           102  2.0  0.0  0.0
           103  3.0  0.0  0.0
           104  4.0  0.0  0.0
           105  5.0  0.0  0.0

        $ELEMENT TYPE = MASS3 ESET = M1
             1  101
        $ELEMENT TYPE = MASS3 ESET = M2
             2  102
        $ELEMENT TYPE = MASS3 ESET = M3
             3  103
        $ELEMENT TYPE = MASS3 ESET = M4
             4  104
        $ELEMENT TYPE = MASS3 ESET = M5
             5  105
 
        $ELEMENT TYPE = SPRING1 ESET = K1
             6  100  101
        $ELEMENT TYPE = SPRING1 ESET = K2
             7  101  102
        $ELEMENT TYPE = SPRING1 ESET = K3
             8  102  103
        $ELEMENT TYPE = SPRING1 ESET = K4
             9  103  104
        $ELEMENT TYPE = SPRING1 ESET = K5
            10  104  105


        $ELEMENT TYPE = DAMP1 ESET = C1
            11  100  101
        $ELEMENT TYPE = DAMP1 ESET = C2
            12  101  102
        $ELEMENT TYPE = DAMP1 ESET = C3
            13  102  103
        $ELEMENT TYPE = DAMP1 ESET = C4
            14  103  104
        $ELEMENT TYPE = DAMP1 ESET = C5
            15  104  105

    $END STRUCTURE

    $SYSTEM NAME = S_STEP_1

       $GEODAT MASS CONT = MASS
          GD_M1  80.0
          GD_M2  70.0
          GD_M3  60.0
          GD_M4  50.0
          GD_M5  40.0

       $GEODAT SPRING CONT = STIFF
          GD_K1  3.0E+07
          GD_K2  2.8E+07
          GD_K3  2.6E+07
          GD_K4  2.4E+07
          GD_K5  2.2E+07
 
       $GEODAT DAMPER CONT = DAMP
          GD_C1  1.2E+03
          GD_C2  1.1E+03
          GD_C3  1.0E+03
          GD_C4  0.9E+03
          GD_C5  0.8E+03
 
       $ELPROP
          M1 GEODAT = GD_M1
          M2 GEODAT = GD_M2
          M3 GEODAT = GD_M3
          M4 GEODAT = GD_M4
          M5 GEODAT = GD_M5

          C1 GEODAT = GD_C1
          C2 GEODAT = GD_C2
          C3 GEODAT = GD_C3
          C4 GEODAT = GD_C4
          C5 GEODAT = GD_C5

          K1 GEODAT = GD_K1
          K2 GEODAT = GD_K2
          K3 GEODAT = GD_K3
          K4 GEODAT = GD_K4
          K5 GEODAT = GD_K5

    $END SYSTEM

    $CONSTRAINTS NAME = C_STEP_1

        $SUPPRESS DOFS = 1
           GROUND

        $SUPPRESS DOFS = 2,3
           ALL_NODES

    $END CONSTRAINTS

    $LOADING NAME = L_STEP_2

        $CONLOAD LPAT = 1
           101  1: 1.0
        $CONLOAD LPAT = 2
           102  1: 1.0
        $CONLOAD LPAT = 3
           103  1: 1.0
        $CONLOAD LPAT = 4
           104  1: 1.0
        $CONLOAD LPAT = 5
           105  1: 1.0

        $TRANSLOAD
           LPAT = 1 FUNCTION = WHITENOISE TYPE = PSD SEED = 111111111
           LPAT = 2 FUNCTION = WHITENOISE TYPE = PSD SEED = 222222222
           LPAT = 3 FUNCTION = WHITENOISE TYPE = PSD SEED = 333333333
           LPAT = 4 FUNCTION = WHITENOISE TYPE = PSD SEED = 444444444
           LPAT = 5 FUNCTION = WHITENOISE TYPE = PSD SEED = 555555555

    $END LOADING

$EXIT COMPONENT
$ENTER FUNCTION

  $FUNCTION FORMULA LABEL = WHITENOISE
     F(T) = 1.0
  
$EXIT FUNCTION
$FIN