NEW

INPUT
    READ PERMAS FILE = duthe.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    DIRECT TIMEHISTORY LOOPS = 500 &
                       DELTAT = 0.04 &
                       TSTART = 0.0 &
                       INNER = 5 &
                       OUTPUT = ALL &
                       STORE = ALL &
                       SOLV = NEWMARK 
SELECT
    ACTIVE NSET = FREE
    XYDATA ITEM DISP RESULT = U   DCOMP = 2
    XYDATA ITEM VELO RESULT = UP  DCOMP = 2
    XYDATA ITEM ACCE RESULT = UPP DCOMP = 2
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = U
    ITEM XYDATA TYPE = VELO NAME = UP
    ITEM XYDATA TYPE = ACCE NAME = UPP
    GO PERMAS BINARY FILE = response
TASK END
STOP