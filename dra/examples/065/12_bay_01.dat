$ENTER FUNCTION

    $FUNCTION FORMULA LABEL = F4 
       F(T) = 50*SIN(18*PI*T)+45*SIN(70*PI*T)+45*SIN(210*PI*T)

    $FUNCTION FORMULA LABEL = F10 
       F(T) = 65*SIN(20*PI*T)+60*SIN(80*PI*T)+55*SIN(160*PI*T)

    $FUNCTION FORMULA LABEL = F16 
       F(T) = 55*SIN(18*PI*T)+50*SIN(50*PI*T)+50*SIN(160*PI*T)

    $FUNCTION FORMULA LABEL = F22 
       F(T) = 60*SIN(20*PI*T)+55*SIN(30*PI*T)+50*SIN(210*PI*T)

$EXIT FUNCTION
