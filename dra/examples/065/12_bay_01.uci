NEW

INPUT
    READ PERMAS FILE = 12_bay_01.dat
RETURN

TASK 
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 30
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
EXEC
    ACTIVE NSET = RESPONSE
    MODAL TIMEHISTORY SITUATION = STEP_2 &
                      LOOPS = 1000 &   ! EDU limit   
                      DELTAT = 0.0005 &
                      TSTART = 0.0 &
                      OUTPUT = ALL &
                      PRIMRES = REDUCED &
                      SOLV = NEWMARK 
!   ACT SIT = STEP_2  ! needed until V21
SELECT
    ACTIVE NSET = RESPONSE
    XYDATA ITEM DISP RESULT = U   DCOMP = 2
    XYDATA ITEM VELO RESULT = UP  DCOMP = 2
    XYDATA ITEM ACCE RESULT = UPP DCOMP = 2
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = U
    ITEM XYDATA TYPE = VELO NAME = UP
    ITEM XYDATA TYPE = ACCE NAME = UPP
    GO PERMAS BINARY FILE = transient
    GO SPREADSHEET FILE = transient
TASK END
STOP