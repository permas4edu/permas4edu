$ENTER COMPONENT NAME = DFLT_COMP
!
    $SITUATION NAME = STEP_1
       DFLT_COMP SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1
    $END SITUATION
!
    $SITUATION NAME = STEP_2  PARENT = STEP_1
       DFLT_COMP SYSTEM = S_STEP_1 
    $END SITUATION
!
    $SITUATION NAME = STEP_3  PARENT = STEP_1
       DFLT_COMP SYSTEM = S_STEP_1  LOADING = L_STEP_3  RESULTS = R_STEP_3 
    $END SITUATION
!
    $STRUCTURE

       $NSET NAME = GROUND
          100  200

       $NSET NAME = FREE RULE = BOOLEAN
          ALL_NODES AND NOT GROUND

       $NODE NSET = ALL_NODES
          100  0.0  0.0  0.0
          101  0.0  0.0  0.0
          102  0.0  0.0  0.0
          103  0.0  0.0  0.0
          200  0.0  0.0  0.0
 
       $ELEMENT TYPE = MASS3 ESET = M
            1  101
            2  102
            3  103
 
       $ELEMENT TYPE = SPRING1 ESET = KP
            4  102  200
            5  103  200
            6  101  102
            7  102  103
       $ELEMENT TYPE = SPRING1 ESET = K1
            8  101  100
       $ELEMENT TYPE = SPRING1 ESET = K6
            9  101  103
   
    $END STRUCTURE

    $SYSTEM NAME = S_STEP_1
!
       $COMPDAMP
!        Damping ratio xi = 0.020
!        Standard approach
         ALPHA = 9.999996e-03 BETA = 3.000001e-02

       $GEODAT MASS CONT = MASS
          GD_M  1.0

       $GEODAT SPRING CONT = STIFF
          GD_K1  1.0
          GD_K6  3.5
     
       $GEODAT SPRING CONT = STIFF
          GD_KP  1.0

       $ELPROP
           M  GEODAT = GD_M
           K1 GEODAT = GD_K1   
           K6 GEODAT = GD_K6   
           KP GEODAT = GD_KP

    $END SYSTEM

    $CONSTRAINTS NAME = C_STEP_1

       $SUPPRESS DOFS = 1
           GROUND

       $SUPPRESS DOFS = 2,3
           ALL_NODES

    $END CONSTRAINTS
  
    $LOADING NAME = L_STEP_3

       $CONLOAD LPAT = 1
         101 1 : 1.0

       $FREQLOAD
          LPAT = 1 TYPE = TOTAL
 
    $END LOADING

    $RESULTS NAME = R_STEP_3

        $FREQUENCY PRIMARY = EQUI XTYPE = OMEGA
           0.05 3.75 0.0185

    $END RESULTS

$EXIT COMPONENT
$FIN

