$ENTER COMPONENT  NAME = DFLT_COMP  DOFTYPE = DISP MATH
!------
   $SITUATION  NAME = SAMPLING  CONNECTED = STEP_1 STEP_2 STEP_3
      DFLT_COMP  SYSTEM = S_STEP_1  RESULTS = R_STEP_3
   $END SITUATION
!
   $STRUCTURE
!
      $DELEMENT TYPE = DMASS
                1          1: M
      $DELEMENT TYPE = DSPRING
                2          2: KP
!
   $END STRUCTURE
!------
   $SYSTEM  NAME = S_STEP_1
!
      $DVGPAR MASS  NAME = GD_M  DEID = 1
      MASS          1:          1
      $DVGPAR SPRING  NAME = GD_KP  DEID = 2
      STIFF          1:          2
!
   $END SYSTEM
!------
   $RESULTS  NAME = R_STEP_3
!
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_1  MODE = 1
      F_1
!
      $VPARVAL  TYPE = DESVAR  INPUT = EQUI
                1  9.000000E-01  1.100000E+00  1.000000E-02
                2  9.000000E-01  1.100000E+00  1.000000E-02
!
      $RESEXT  ITEM
      F_1 : F_1          1
!
   $END RESULTS
!------
$EXIT COMPONENT
!------------------------------------
$FIN
