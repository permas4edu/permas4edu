NEW

INPUT
    READ PERMAS FILE = 3DOF.dat
    READ PERMAS FILE = 3DOF_sampling.dat
RETURN

PORT RES REPLACE FILE = natural_frequencies.txt
PORT RES RESET
PORT RES REPLACE FILE = complex_frequencies.txt
PORT RES RESET

TASK LOOPS = 441
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 3
PRINT  
    PORT RES SWITCH TO FILE = natural_frequencies.txt
    TEXT = 'Loop: %.3(tloop)'
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
!EXPORT
!    ITEM MODL
!    GO PERMAS BINARY FILE = normal_modes
EXEC
    MODAL COMPLEX SITUATION = STEP_2
    ACT SIT = STEP_2
PRINT
    PORT RES SWITCH TO FILE = complex_frequencies.txt
    TEXT = 'Loop: %.3(tloop)'
    DATA OBJECT CVALTAB.DISP
    PORT RES RESET
EXEC
    MODAL FREQUENCY SITUATION = STEP_3
    ACT SIT = STEP_3
SELECT
    ACTIVE NSET = FREE
    XYDATA ITEM DISP RESULT = FRF DCOMP = 1
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = FRF
    GO PERMAS BINARY FILE = 'frf_%.3(tloop)'
EXEC
    ACT SIT = SAMPLING
    SAMPLING  
TASK END
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DHIS
    ITEM XYDATA TYPE = SRHIS
    GO PERMAS BINARY FILE = sampling  
STOP
