SET MESHOPT = OFF
NEW

INPUT
    READ PERMAS FILE = ndof_mass_spring_dashpot.dat
RETURN

TASK 
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 50  FREQLIM = 1000.0
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt  
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
SELECT
    ACTIVE NSET = ALL_NODES
    XYDATA ITEM DISP COOR = X RESULT = MODE DCOMP = 1
EXPORT
    ITEM CLEAR XYDATA 
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = MODE 
    GO SPREADSHEET FILE = modes
    OPEN MATLAB ASCII FILE = matrices
    DATA OBJECT BMLL.DISP BLOCKFORM = VALUE
    DATA OBJECT BKLL.DISP BLOCKFORM = VALUE
EXEC
    MODAL COMPLEX SITUATION = STEP_2
    ACT SIT = STEP_2
PRINT
    PORT RES REPLACE FILE = complex_frequencies.txt  
    DATA OBJECT CVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL 
    GO PERMAS BINARY FILE = complex_modes
TASK END
USER
    CALL TOOL6 P1 = 'pyINTES mtl2matplotlib.py'
RETURN
STOP
