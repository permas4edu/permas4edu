NEW

INPUT
    READ PERMAS FILE = steel_ruler_beam.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 10
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
EXEC
    ACTIVE NSET = ACCELEROMETER
    MODAL FREQUENCY SITUATION = COLLECT &
                    PRIMRES = REDUCED

TASK END
CLOOP LOOPS = 1, 33
    ACT SIT = 'FRF_%(cloop)'
SELECT
    ACTIVE NSET = ACCELEROMETER
    XYDATA ITEM DISP RESULT = FRF_U DCOMP = 2 ! Displacement Response in y-direction
    XYDATA ITEM ACCE RESULT = FRF_A DCOMP = 2 ! Acceleration Response in y-direction
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = FRF_U
    GO SPREADSHEET FILE = 'h_%.2(cloop)'
    ITEM CLEAR
    ITEM XYDATA TYPE = ACCE NAME = FRF_A
    GO SPREADSHEET FILE = 'h_%.2(cloop)'
CLOOP END
USER
   CALL TOOL6 P1 = 'pyINTES H.py'
RETURN
STOP
