$DEFVAR FRF TYPE = NAME GEN = FRF_,1,1
$DEFVAR NID TYPE = INTEGER GEN = 1,1
$DEFVAR LOADVAR TYPE = NAME  GEN = L_STEP_,1,1

$ENTER COMPONENT  NAME = DFLT_COMP  DOFTYPE = DISP MATH
!------
   $SITUATION  NAME = STEP_1
      DFLT_COMP  CONSTRAINTS = C_STEP_1  SYSTEM = S_STEP_1
   $END SITUATION
!
   $LOOP I = 1, 33
       $SITUATION NAME = FRF(I) PARENT = STEP_1
           DFLT_COMP SYSTEM = S_STEP_1  LOADING = LOADVAR(I) RESULTS = R_FRF
       $END SITUATION
   $ENDLOOP
!

!
   $SITUATION  NAME = COLLECT PARENT = STEP_1 ASSEMBLY  = FRF_1  FRF_2  FRF_3  FRF_4  FRF_5  FRF_6  FRF_7  FRF_8  FRF_9  FRF_10 FRF_11
&                                                         FRF_12 FRF_13 FRF_14 FRF_15 FRF_16 FRF_17 FRF_18 FRF_19 FRF_20 FRF_21 FRF_22
&                                                         FRF_23 FRF_24 FRF_25 FRF_26 FRF_27 FRF_28 FRF_29 FRF_30 FRF_31 FRF_32 FRF_33

      DFLT_COMP  SYSTEM = S_STEP_1  RESULTS = R_FRF
   $END SITUATION
