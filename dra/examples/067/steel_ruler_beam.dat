!------
   $SYSTEM  NAME = S_STEP_1
!
      $GEODAT BEAM      CONT = SECTTYPE SECTDIM  SECTDIM
       GD_BEAM               5
         &        :  3.000000E+01  1.000000E+00
         &        :  3.000000E+01  1.000000E+00
!
      $ELPROP
       BEAM          GEODAT = GD_BEAM       MATERIAL = STEEL
!
      $ADDMODES SOURCE = LOAD
         LPAT = ALL 
!
   $END SYSTEM
!------
   $CONSTRAINTS  NAME = C_STEP_1
!
   $END CONSTRAINTS
!------
!
   $LOOP I = 1, 33
       $LOADING  NAME = LOADVAR(I)
!
            $CONLOAD LPAT = 1
              NID(I) 2: 1.0 ! Unit load at node i in y-direction

            $FREQLOAD
              LPAT = 1 TYPE = COSINE   
!
       $END LOADING
   $ENDLOOP
!------
   $RESULTS NAME = R_FRF

      $FREQUENCY PRIMARY = LIST
         65.0 ! excitation frequency

   $END RESULTS
!------
$EXIT COMPONENT
!------------------------------------
$ENTER MATERIAL
!------
   $MATERIAL  NAME = STEEL  TYPE = ISO
!
      $ELASTIC  GENERAL  INPUT = DATA
        2.100000E+05  3.000000E-01
!
      $DENSITY  GENERAL  INPUT = DATA
        7.850000E-09
!
   $END MATERIAL
!------
$EXIT MATERIAL
