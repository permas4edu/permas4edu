$ECHO GEN
$DEFVAR NDOF TYPE = INTEGER LIST = 50 51
$DEFVAR X TYPE = REAL GEN = 1.0,1.0
$DEFVAR NID TYPE = INTEGER GEN = 100,1
$DEFVAR EIDM TYPE = INTEGER GEN = 1,1

$ENTER COMPONENT NAME = DFLT_COMP DOFTYPE = DISP MATH

    $SITUATION NAME = STEP_1
       DFLT_COMP SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1
    $END SITUATION

    $STRUCTURE

       $NSET NAME = GROUND
         100 151

       $NSET NAME = FREE RULE = RANGE
         101 150
 
       $NODE NSET = ALL_NODES
         100  0.0 0.0 0.0
         151 51.0 0.0 0.0

       $LOOP I = 1, NDOF(1)
         NID(I+1) X(I) 0.0 0.0
       $ENDLOOP

       $ELEMENT TYPE = MASS3 ESET = M
         $LOOP I = 1, NDOF(1) 
             EIDM(I)  NID(I+1)
         $ENDLOOP
 
       $ELEMENT TYPE = SPRING1 ESET = K
         $LOOP I = 1, NDOF(2)
             EIDM(I+NDOF(1)) NID(I)  NID(I+1)
         $ENDLOOP

    $END STRUCTURE

    $SYSTEM NAME = S_STEP_1
!
!       Caution C = alpha K + beta M in PERMAS 
!
        $COMPDAMP
          ALPHA = 1.E-3   BETA = 1.E-4

        $GEODAT MASS CONT = MASS
           GD_M  2.0

        $GEODAT SPRING CONT = STIFF
           GD_K  2.E+06 

        $ELPROP
           M GEODAT = GD_M
           K GEODAT = GD_K

    $END SYSTEM

    $CONSTRAINTS NAME = C_STEP_1

        $SUPPRESS DOFS = 2,3
           ALL_NODES
 
        $SUPPRESS DOFS = 1
           GROUND
 
    $END CONSTRAINTS 

$EXIT COMPONENT
$FIN