NEW

INPUT
    READ PERMAS FILE = simply_supported_beam.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 40
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
EXEC
    ACTIVE NSET = RESPONSE
    MODAL FREQUENCY SITUATION = STEP_2 &
                     PRIMRES = REDUCED 
    ACT SIT = STEP_2
SELECT
    ACTIVE NSET = RESPONSE
    XYDATA ITEM DISP RESULT = FRF DCOMP = 2
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = FRF             
    GO PERMAS BINARY FILE = frf
TASK END
STOP
