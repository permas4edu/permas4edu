SET MODETRACKING = LASTITER
NEW

INPUT
    READ PERMAS FILE = four_dof_system.dat
    READ PERMAS FILE = four_dof_system_sampling.dat
RETURN

TASK LOOPS = 151
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 4
    ACT SIT = SAMPLING
    SAMPLING
TASK END
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DHIS
    ITEM XYDATA TYPE = SRHIS
    GO SPREADSHEET FILE = sampling
    GO PERMAS BINARY FILE = sampling
USER
    CALL TOOL6 P1 = 'pyINTES four_dof_system.py'
RETURN
STOP