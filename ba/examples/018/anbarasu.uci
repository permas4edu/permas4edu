SET GLOBALITY = ON
SET GLOB_METHOD = RMS ! AVERAGE MAXIMUM
SET GLOB_LIMIT = 0.5
 
NEW

INPUT
    READ PERMAS FILE = anbarasu.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    STATIC
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = statics
EXEC
    ACT SIT = STEP_2
    BUCKLING ANALYSIS MODES = 20 SIGN = POSITIVE
PRINT
    PORT RES REPLACE FILE = load_scale_factors.txt
    DATA OBJECT BVALTAB.DISP
    PORT RES RESET
!
    PORT RES REPLACE FILE = globality.txt
    DATA OBJECT GLOBTBL.DISP
    PORT RES RESET
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = buckling_modes
TASK END
STOP
