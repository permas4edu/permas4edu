PRESET TOLBASE = 1.E-3

NEW

INPUT
    READ PERMAS FILE = 3dof_spring_mass.dat
RETURN

TASK 
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 3 FREQLIM = 1000.0
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    OPEN MATLAB ASCII FILE = matrices
    DATA OBJECT BMLL.DISP BLOCKFORM = VALUE ! mass matrix
    DATA OBJECT BKLL.DISP BLOCKFORM = VALUE ! stiffness matrix
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
TASK END
STOP