NEW

INPUT
    READ PERMAS FILE = hexagonal_space_frame.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 20
    GENERATE STRAIN ENERGY DENSITY
SELECT
    PARTSUM SETBIN = SED ITEM STRAIN ENERGY DENSITY SORT = NONE NAME = SED
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM CLEAR
    ITEM PARTSUM NAME = SED
    GO PERMAS ASCII FILE = strain_energy
    ITEM CLEAR
    ITEM MODL
    ITEM DISP
    GO PERMAS BINARY FILE = normal_modes
TASK END
STOP
