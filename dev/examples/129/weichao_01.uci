NEW

INPUT
    READ PERMAS FILE = weichao_01.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 20
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
    PORT RES REPLACE FILE = efmar.txt ! Relative effective masses
    DATA OBJECT EFMAR.DISP
    PORT RES RESET
SELECT
    ACTIVE NSET = ALL_NODES
    XYDATA ITEM DISP COOR = Y RESULT = MODE DCOMP = 2,3
EXPORT
    ITEM CLEAR XYDATA
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = MODE
    GO SPREADSHEET FILE = mode
    GO PERMAS BINARY FILE = mode
TASK END
STOP
