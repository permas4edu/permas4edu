SET SFPRINT = 2

NEW

INPUT
    READ PERMAS FILE = natalia_edu.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 10
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
    ITEM CLEAR
    ITEM DISP
    CURRENT ESET = PLOT
    ITEM PART
    GO PERMAS BINARY FILE = ema
    GO IDEAS FILE = ema
TASK END
STOP
