NEW

INPUT
    READ PERMAS FILE = 4_dof.dat
RETURN

EXEC
   ACT CONFIG = DFLT_COMP
TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 4
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
TASK END

EXEC
    ACT CONFIG = PERTURBED
TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 4 FREQLIM = 10.0
EXPORT
    OPEN MATLAB FILE = matrices
    DATA OBJECT BKLL.DISP BLOCKFORM = VALUE
    DATA OBJECT BMLL.DISP BLOCKFORM = VALUE
PRINT
    PORT RES REPLACE FILE = natural_frequencies_perturbed.txt
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes_perturbed
EXEC
    MODAL COMPLEX SITUATION = STEP_2
PRINT
    PORT RES REPLACE FILE = complex_frequencies.txt
    DATA OBJECT CVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = complex_modes
TASK END
STOP