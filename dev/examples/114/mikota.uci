DEFAULT SET PRINT_DIGITS = 7

NEW

USER
    CALL TOOL6 P1 = 'pyINTES mikota.py 5'
RETURN

INPUT
    READ PERMAS FILE = mikota_01.dat
RETURN
TASK
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 4
SELECT
    ACTIVE NSET = FREE
    XYDATA ITEM DISP COOR = X RESULT = MODE DCOMP = 1
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM CLEAR XYDATA
    GO PERMAS BINARY FILE = normal_modes
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = MODE
    GO SPREADSHEET FILE = normal_modes
TASK END
STOP
