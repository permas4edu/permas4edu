$ENTER COMPONENT NAME = DFLT_COMP

    $SITUATION NAME = STEP_1
        DFLT_COMP SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1
    $END SITUATION

    $STRUCTURE

        $NSET NAME = FREE RULE = RANGE
          2 5

        $COOR
       1 0.00000e+00 0.00000e+00 0.00000e+00
       2 1.00000e+00 0.00000e+00 0.00000e+00
       3 2.00000e+00 0.00000e+00 0.00000e+00
       4 3.00000e+00 0.00000e+00 0.00000e+00
       5 4.00000e+00 0.00000e+00 0.00000e+00

        $ELEMENT TYPE = MASS3 ESET = MASS

                1        2
                2        3
                3        4
                4        5

        $ELEMENT TYPE = SPRING1 ESET = SPRING

                5        1        2
                6        2        3
                7        3        4
                8        4        5

    $END STRUCTURE

$SYSTEM NAME = S_STEP_1

        $GEODAT MASS CONT = MASS
         GD_MASS_1 1.00000e+00
        $GEODAT MASS CONT = MASS
         GD_MASS_2 5.00000e-01
        $GEODAT MASS CONT = MASS
         GD_MASS_3 3.33333e-01
        $GEODAT MASS CONT = MASS
         GD_MASS_4 2.50000e-01

        $GEODAT SPRING CONT = STIFF
         GD_SPRING_1 4.00000e+00
        $GEODAT SPRING CONT = STIFF
         GD_SPRING_2 3.00000e+00
        $GEODAT SPRING CONT = STIFF
         GD_SPRING_3 2.00000e+00
        $GEODAT SPRING CONT = STIFF
         GD_SPRING_4 1.00000e+00

            $ELPROP
                    1 GEODAT = GD_MASS_1
                    2 GEODAT = GD_MASS_2
                    3 GEODAT = GD_MASS_3
                    4 GEODAT = GD_MASS_4
                    5 GEODAT = GD_SPRING_1
                    6 GEODAT = GD_SPRING_2
                    7 GEODAT = GD_SPRING_3
                    8 GEODAT = GD_SPRING_4

    $END SYSTEM

    $CONSTRAINTS NAME = C_STEP_1

        $SUPPRESS DOFS = 2,3
            FREE
        $SUPPRESS DOFS = 1,2,3
            1

    $END CONSTRAINTS

$EXIT COMPONENT

$FIN
