NEW

INPUT
    READ PERMAS FILE = euler_bernoulli.dat
    READ PERMAS FILE = euler_bernoulli_sampling.dat
RETURN

TASK LOOPS = 1
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 20
    GEN STRAIN ENERGY
SELECT
    PARTSUM SETBIN = BEAMS ITEM STRAIN ENERGY SORT = NONE NAME = SE
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt
    TEXT = 'Clamped-Free'
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM CLEAR XYDATA
    ITEM MODL NEWCOOR
    GO PERMAS BINARY FILE = 'cf_normal_modes_%.3(tloop)'
    ITEM CLEAR
    ITEM PARTSUM NAME = SE
    GO PERMAS ASCII FILE = 'cf_strain_energy_%.3(tloop)'
EXEC
    ACT SIT = STEP_2
    VIBRATION ANALYSIS MODES = 20
    GEN STRAIN ENERGY
SELECT
    PARTSUM SETBIN = BEAMS ITEM STRAIN ENERGY SORT = NONE NAME = SE
PRINT
    PORT RES SWITCH FILE = natural_frequencies.txt
    TEXT = 'Simply supported'
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM CLEAR XYDATA
    ITEM MODL NEWCOOR
    GO PERMAS BINARY FILE = 'ss_normal_modes_%.3(tloop)'
    ITEM CLEAR
    ITEM PARTSUM NAME = SE
    GO PERMAS ASCII FILE = 'ss_strain_energy_%.3(tloop)'
EXEC
    ACT SIT = SAMPLING
    SAMPLING 
TASK END
EXPORT
    ITEM CLEAR
    ITEM XYDATA TYPE = DHIS
    ITEM XYDATA TYPE = SRHIS
    GO SPREADSHEET FILE = sampling
STOP
