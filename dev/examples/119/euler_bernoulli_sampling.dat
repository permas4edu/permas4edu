$ENTER COMPONENT  NAME = DFLT_COMP  DOFTYPE = DISP MATH
!------
   $SITUATION  NAME = SAMPLING  CONNECTED = STEP_1 STEP_2
      DFLT_COMP  SYSTEM = S_STEP_1
   $END SITUATION
!
   $STRUCTURE
!
      $DELEMENT TYPE = DSHAPE
                1: BEAM_01
         &      : TIP_01
                2: BEAM_02
         &      : TIP_02
!
      $DSVNODE
                1 TIP_01      :          1
                2 TIP_02      :          2
!
      $DERESTRAINT  TYPE = BOUND
                1  0 : ROOT_01
                2  0 : ROOT_02
!
      $NSET NAME = ROOT_01
                1
      $NSET NAME = ROOT_02
                3
      $NSET NAME = TIP_01
                2
      $NSET NAME = TIP_02
                4
!
   $END STRUCTURE
!------
   $SYSTEM  NAME = S_STEP_1
!
      $DVCOOR  KIND = DIRECT
       TIP_01       1 :  1.000000E+00 :          1
       TIP_02       1 :  1.000000E+00 :          2
!
   $END SYSTEM
!------
   $RESULTS
!
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 1
      F_1
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 2
      F_2
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 3
      F_3
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 4
      F_4
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 5
      F_5
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 6
      F_6
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 7
      F_7
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 8
      F_8
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 9
      F_9
      $RSLITEM FREQ  TYPE = GLOBAL  SITUATION = STEP_2  MODE = 10
      F_10
!
      $VPARVAL  TYPE = DESVAR
                1  0.000000E+00
                2  0.000000E+00

!
      $RESEXT  FUNCTION
      OMEGA_1  : F_1          1 :          1
      OMEGA_2  : F_2          1 :          1
      OMEGA_3  : F_3          1 :          1
      OMEGA_4  : F_4          1 :          1
      OMEGA_5  : F_5          1 :          1
      OMEGA_6  : F_6          1 :          1
      OMEGA_7  : F_7          1 :          1
      OMEGA_8  : F_8          1 :          1
      OMEGA_9  : F_9          1 :          1
      OMEGA_10 : F_10         1 :          1
!
   $END RESULTS
!------
$EXIT COMPONENT
!------------------------------------
$ENTER FUNCTION
!------
   $FUNCTION FORMULA  FID =          1  DESCRIPTION = 'Natural frequency'
   F(X)=2*PI*X
!------
$EXIT FUNCTION
!------------------------------------
$FIN
