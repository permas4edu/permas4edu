$ENTER COMPONENT NAME = DFLT_COMP

    $SITUATION NAME = STEP_1
       DFLT_COMP  SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1
    $END SITUATION

    $STRUCTURE

       $NSET NAME = GROUND
           100

       $NODE NSET = ALL_NODES
           100  0.0  0.0  0.0
           101  0.0  1.0  0.0
           102  0.0  2.0  0.0
           103  0.0  3.0  0.0
           104  0.0  4.0  0.0
           105  0.0  5.0  0.0

       $ELEMENT TYPE = MASS3 ESET = M_1
             1  101
       $ELEMENT TYPE = MASS3 ESET = M_2
             2  102
       $ELEMENT TYPE = MASS3 ESET = M_3
             3  103
       $ELEMENT TYPE = MASS3 ESET = M_4
             4  104
       $ELEMENT TYPE = MASS3 ESET = M_5
             5  105
  
       $ELEMENT TYPE = SPRING1 ESET = K_1
             6  100  101
       $ELEMENT TYPE = SPRING1 ESET = K_2
             7  101  102
       $ELEMENT TYPE = SPRING1 ESET = K_3
             8  102  103
       $ELEMENT TYPE = SPRING1 ESET = K_4
             9  103  104
       $ELEMENT TYPE = SPRING1 ESET = K_5
            10  104  105
   
    $END STRUCTURE

    $SYSTEM NAME = S_STEP_1

        $GEODAT MASS CONT = MASS
           GD_M1  2.152E+05
           GD_M2  2.092E+05
           GD_M3  2.070E+05
           GD_M4  2.048E+05
           GD_M5  2.661E+05
   
        $GEODAT SPRING CONT = STIFF
           GD_K1  1.470E+08
           GD_K2  1.130E+08
           GD_K3  0.990E+08
           GD_K4  0.890E+08
           GD_K5  0.840E+08

        $ELPROP
            M_1  GEODAT = GD_M1
            M_2  GEODAT = GD_M2
            M_3  GEODAT = GD_M3
            M_4  GEODAT = GD_M4
            M_5  GEODAT = GD_M5

            K_1  GEODAT = GD_K1
            K_2  GEODAT = GD_K2
            K_3  GEODAT = GD_K3
            K_4  GEODAT = GD_K4
            K_5  GEODAT = GD_K5
 
    $END SYSTEM

    $CONSTRAINTS NAME = C_STEP_1

         $SUPPRESS DOFS = 1,3
            ALL_NODES
 
         $SUPPRESS DOFS = 2
            GROUND

    $END CONSTRAINTS

$EXIT COMPONENT
$FIN