NEW

INPUT
    READ PERMAS FILE = five_storey_building.dat
RETURN

TASK 
EXEC
    ACT SIT = STEP_1
    VIBRATION ANALYSIS MODES = 5
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt 
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
SELECT
    ACTIVE NSET = ALL_NODES
    XYDATA ITEM DISP COOR = Y RESULT = MODE DCOMP = 1
EXPORT
    ITEM CLEAR XYDATA 
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes
    ITEM CLEAR
    ITEM XYDATA TYPE = DISP NAME = MODE
    GO SPREADSHEET FILE = modes
TASK END
USER
    CALL TOOL6 P1 ='pyINTES five_storey_building.py'
RETURN
STOP