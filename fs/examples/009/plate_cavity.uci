NEW

INPUT
    READ PERMAS FILE = plate_cavity.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1
    FLUID VIBRATION ANALYSIS MODES = 20
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = f_modes
EXEC
    ACT SIT = STEP_2
    VIBRATION ANALYSIS MODES = 20
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE =  s_modes
EXEC
    ACT SIT = STEP_3
    FSCOUPLED VIBRATION ANALYSIS MODES = 20
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = fs_modes
TASK END
STOP