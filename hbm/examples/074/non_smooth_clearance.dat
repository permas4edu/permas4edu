$DEFVAR EPS TYPE = REAL LIST = 1.E-3  ! Regularization parameter
$DEFVAR A TYPE = REAL LIST =  0.02  ! clearance half-width
$DEFVAR MU TYPE = REAL LIST = 0.5 1.5 2.5 3.5 4.5 !  
$DEFVAR P TYPE = REAL LIST = 0.015  ! magnitude of harmonic force P*mu  (P=1.0)
$DEFVAR C TYPE = REAL LIST = 0.04   ! viscous damper c  * mu  (c=1.0)
$DEFVAR BETA TYPE = REAL LIST =  1.5 ! Duffing 
$DEFVAR K TYPE = REAL LIST = 10.0 ! stiffness

$ENTER COMPONENT NAME = DFLT_COMP DOFTYPE = DISP

   $SITUATION NAME = STEP_1
      DFLT_COMP SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1  LOADING = L_STEP_1  RESULTS = R_STEP_1
   $END SITUATION
!
   $SITUATION NAME = STEP_2
      DFLT_COMP SYSTEM = S_STEP_2  CONSTRAINTS = C_STEP_1  LOADING = L_STEP_2  RESULTS = R_STEP_1
   $END SITUATION
!
   $SITUATION NAME = STEP_3
      DFLT_COMP SYSTEM = S_STEP_3  CONSTRAINTS = C_STEP_1  LOADING = L_STEP_3  RESULTS = R_STEP_1
   $END SITUATION
!
   $SITUATION NAME = STEP_4
      DFLT_COMP SYSTEM = S_STEP_4  CONSTRAINTS = C_STEP_1  LOADING = L_STEP_4  RESULTS = R_STEP_1
   $END SITUATION
!
   $SITUATION NAME = STEP_5
      DFLT_COMP SYSTEM = S_STEP_5  CONSTRAINTS = C_STEP_1  LOADING = L_STEP_5  RESULTS = R_STEP_1
   $END SITUATION
!
   $STRUCTURE

       $NSET NAME = RESULTS 
         101

       $NODE NSET = ALL_NODES
         100  0.0  0.0  0.0
         101  1.0  0.0  0.0

       $NSET NAME = GROUND
         100
 
       $ELEMENT TYPE = MASS3 ESET = M
           1  101

       $ELEMENT TYPE = NLSTIFF ESET = NL_K
           2  100  101

       $ELEMENT TYPE = DAMP1 ESET = C
           3  100  101

       $ELEMENT TYPE = SPRING1 ESET = K
           4  100  101
 
   $END STRUCTURE

   $SYSTEM NAME = S_STEP_1

      $GEODAT MASS CONT = MASS
         GD_M  1.0

      $GEODAT DAMPER CONT = DAMP
         GD_C  0.02

      $GEODAT SPRING CONT = FUNCTION
         GD_NL_K  2

      $GEODAT SPRING CONT = STIFF
         GD_K  1.0
         
      $ELPROP
          M    GEODAT = GD_M
          C    GEODAT = GD_C
          K    GEODAT = GD_K  
          NL_K GEODAT = GD_NL_K   
 
   $END SYSTEM
!
   $SYSTEM NAME = S_STEP_2

      $GEODAT MASS CONT = MASS
         GD_M  1.0

      $GEODAT DAMPER CONT = DAMP
         GD_C  0.06 ! mu*c  mu=1.5

      $GEODAT SPRING CONT = FUNCTION
         GD_NL_K  2
         
      $GEODAT SPRING CONT = STIFF
         GD_K  1.0
         
      $ELPROP
          M    GEODAT = GD_M
          C    GEODAT = GD_C
          K    GEODAT = GD_K
          NL_K GEODAT = GD_NL_K   
 
   $END SYSTEM
!
   $SYSTEM NAME = S_STEP_3

      $GEODAT MASS CONT = MASS
         GD_M  1.0

      $GEODAT DAMPER CONT = DAMP
         GD_C  0.1 ! mu*c  mu=2.5

      $GEODAT SPRING CONT = FUNCTION
         GD_NL_K  2
         
      $GEODAT SPRING CONT = STIFF
         GD_K  1.0
         
      $ELPROP
          M    GEODAT = GD_M
          C    GEODAT = GD_C
          K    GEODAT = GD_K
          NL_K GEODAT = GD_NL_K   
 
   $END SYSTEM
!
   $SYSTEM NAME = S_STEP_4

      $GEODAT MASS CONT = MASS
         GD_M  1.0

      $GEODAT DAMPER CONT = DAMP
         GD_C  0.14 ! mu*c  mu=3.5

      $GEODAT SPRING CONT = FUNCTION
         GD_NL_K  2
         
      $GEODAT SPRING CONT = STIFF
         GD_K  1.0
         
      $ELPROP
          M    GEODAT = GD_M
          C    GEODAT = GD_C
          K    GEODAT = GD_K
          NL_K GEODAT = GD_NL_K   
 
   $END SYSTEM
!
   $SYSTEM NAME = S_STEP_5

      $GEODAT MASS CONT = MASS
         GD_M  1.0

      $GEODAT DAMPER CONT = DAMP
         GD_C  0.18 ! mu*c  mu=4.5

      $GEODAT SPRING CONT = FUNCTION
         GD_NL_K  2
         
      $GEODAT SPRING CONT = STIFF
         GD_K  1.0
         
      $ELPROP
          M    GEODAT = GD_M
          C    GEODAT = GD_C
          K    GEODAT = GD_K          
          NL_K GEODAT = GD_NL_K   
 
   $END SYSTEM
!
   $CONSTRAINTS NAME = C_STEP_1
  
       $SUPPRESS DOFS = 2,3
         ALL_NODES
 
       $SUPPRESS  DOFS = 1
         GROUND

   $END CONSTRAINTS
!
   $LOADING NAME = L_STEP_1

     $CONLOAD LPAT = 1
         101 1: 0.0075 ! mu*P  mu=0.5

     $FREQLOAD 
         LPAT = 1 TYPE = COSINE HARMONIC = 1
 
   $END LOADING
!
   $LOADING NAME = L_STEP_2

     $CONLOAD LPAT = 1
         101 1: 0.025 ! mu*P  mu=1.5

     $FREQLOAD 
         LPAT = 1 TYPE = COSINE HARMONIC = 1
 
   $END LOADING
!
   $LOADING NAME = L_STEP_3

     $CONLOAD LPAT = 1
         101 1: 0.0375 ! mu*P  mu=2.5 

     $FREQLOAD 
         LPAT = 1 TYPE = COSINE HARMONIC = 1
 
   $END LOADING
!
   $LOADING NAME = L_STEP_4

     $CONLOAD LPAT = 1
         101 1: 0.0525 ! mu*P  mu=3.5 

     $FREQLOAD 
         LPAT = 1 TYPE = COSINE HARMONIC = 1
 
   $END LOADING
!
   $LOADING NAME = L_STEP_5

     $CONLOAD LPAT = 1
         101 1: 0.0675 ! mu*P  mu=4.5 

     $FREQLOAD 
         LPAT = 1 TYPE = COSINE HARMONIC = 1
 
   $END LOADING
!
   $RESULTS NAME = R_STEP_1

      $FREQUENCY PRIMARY = EQUI XTYPE = OMEGA
          0.0  3.5 0.05

   $END RESULTS  

$EXIT COMPONENT

$ENTER FUNCTION

    $FUNCTION FORMULA LABEL = 1 DESCRIPTION = 'Square-Root Regularization'
      F(X) = 0.5*K(1)* ( SQRT( (X-A(1))^2+ EPS(1) ) - SQRT( (X+A(1))^2 + EPS(1))+ 2*X ) +BETA(1)*X^3 -X

    $FUNCTION FORMULA LABEL = 2 DESCRIPTION = 'Hyperbolic Tangent Regularization'
      F(X) = 0.5*K(1)*((X-A(1))*(1+TANH((X-A(1))/EPS(1)))+(X+A(1))*(1-TANH((X+A(1))/EPS(1)))) +BETA(1)*X^3 -X 

$EXIT FUNCTION
$FIN
