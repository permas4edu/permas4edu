$ENTER COMPONENT NAME = DFLT_COMP

    $SITUATION NAME = STEP_1 
        DFLT_COMP SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1  LOADING = L_STEP_1  RESULTS = R_STEP_1
    $END SITUATION

    $STRUCTURE

        $NODE NSET = ALL_NODES
           100  0.0  0.0  0.0
           101  1.0  0.0  0.0

        $NSET NAME = GROUND 
           100

        $NSET NAME = F
           101

        $ELEMENT TYPE = MASS3 ESET = M
             1  101
! 
        $ELEMENT TYPE = SPRING1 ESET = K
             2  100  101
!
        $ELEMENT TYPE = DAMP1 ESET = C
             3  100  101

        $ELEMENT TYPE = NLSTIFF ESET = K_NL
             4  100  101
  
    $END STRUCTURE

    $SYSTEM NAME = S_STEP_1

       $GEODAT MASS CONT = MASS 
          GD_M  1.0

       $GEODAT SPRING CONT = STIFF
          GD_K  1.0

       $GEODAT DAMPER CONT  = DAMP
          GD_C  0.05

       $GEODAT SPRING CONT = FUNCTION
          GD_K_NL  CUBIC
 
       $ELPROP
          M     GEODAT = GD_M
          C     GEODAT = GD_C
          K     GEODAT = GD_K
          K_NL  GEODAT = GD_K_NL

    $END SYSTEM

    $CONSTRAINTS NAME = C_STEP_1

        $SUPPRESS DOFS = 2,3
           ALL_NODES
 
        $SUPPRESS DOFS = 1
           GROUND
 
    $END CONSTRAINTS

    $LOADING NAME = L_STEP_1

       $CONLOAD LPAT = 1
          F  1: 0.2
 
       $FREQLOAD
          LPAT = 1  TYPE = COSINE

    $END LOADING

    $RESULTS NAME = R_STEP_1

       $FREQUENCY PRIMARY = EQUI XTYPE = OMEGA
          0.0  1.6 0.01
           
    $END RESULTS

$EXIT COMPONENT
$ENTER FUNCTION

   $DEFVAR GAMMA TYPE = REAL LIST = 0.1

   $FUNCTION FORMULA LABEL = CUBIC DESCRIPTION = 'DUFFING'
      F(X) = GAMMA(1)*X^3

$EXIT FUNCTION
$FIN