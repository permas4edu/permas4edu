NEW

INPUT
    READ PERMAS FILE = stylianos.dat
RETURN

EXEC
   CLOOP LOOPS = 1, 3
   TASK
   EXEC
       ACT SIT = 'STEP_%(cloop)'
       DIRECT HARMONIC BALANCE FFTSIZE = 1024 &
                               ACCURACY = 5.0 &
                               NOFHARMONICS = 7 &
                               MODE = FOLLOWPATH &
                               DIRECTION = ASCENDING &
                               STARTFREQ = 0.0 &
                               RESULTS = ALL 
    SELECT
        ACTIVE NSET = RESULTS
        XYDATA ITEM DISP RESULT = HBM DCOMP = 1
    EXPORT
        ITEM CLEAR
        ITEM XYDATA TYPE = DISP NAME = HBM
        GO PERMAS BINARY FILE = 'hbm_%(cloop)'
        GO SPREADSHEET FILE = 'hbm_%(cloop)'
    TASK END
CLOOP END
USER
    CALL TOOL6 P1 = 'pyINTES stylianos.py'
RETURN
STOP
