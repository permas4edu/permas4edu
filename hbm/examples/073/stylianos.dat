$DEFVAR EPS TYPE = REAL LIST = 1.E-3  ! Regularization parameter
$DEFVAR B TYPE = REAL LIST =  0.2  0.6 1.0 !  damping coefficient
$DEFVAR K TYPE = REAL LIST = 1.0 !  
$DEFVAR F_0 TYPE = REAL LIST = 1.0  
$ENTER COMPONENT NAME = DFLT_COMP DOFTYPE = DISP

   $SITUATION NAME = STEP_1
      DFLT_COMP SYSTEM = S_STEP_1  CONSTRAINTS = C_STEP_1  LOADING = L_STEP_1  RESULTS = R_STEP_1
   $END SITUATION
!
   $SITUATION NAME = STEP_2
      DFLT_COMP SYSTEM = S_STEP_2  CONSTRAINTS = C_STEP_1  LOADING = L_STEP_1  RESULTS = R_STEP_1
   $END SITUATION
!
   $SITUATION NAME = STEP_3
      DFLT_COMP SYSTEM = S_STEP_3  CONSTRAINTS = C_STEP_1  LOADING = L_STEP_1  RESULTS = R_STEP_1
   $END SITUATION
!
   $STRUCTURE

       $NSET NAME = RESULTS 
         101

       $NODE NSET = ALL_NODES
         100  0.0  0.0  0.0
         101  1.0  0.0  0.0

       $NSET NAME = GROUND
         100
 
       $ELEMENT TYPE = MASS3 ESET = M
           1  101

       $ELEMENT TYPE = NLSTIFF ESET = NL_K
           2  100  101

       $ELEMENT TYPE = DAMP1 ESET = C
           3  100  101
 
   $END STRUCTURE

   $SYSTEM NAME = S_STEP_1

      $GEODAT MASS CONT = MASS
         GD_M  1.0

      $GEODAT DAMPER CONT = DAMP
         GD_C  B(1)

      $GEODAT SPRING CONT = FUNCTION
         GD_NL_K  1

      $ELPROP
          M    GEODAT = GD_M
          C    GEODAT = GD_C
          NL_K GEODAT = GD_NL_K   
 
   $END SYSTEM
!
   $SYSTEM NAME = S_STEP_2

      $GEODAT MASS CONT = MASS
         GD_M  1.0

      $GEODAT DAMPER CONT = DAMP
         GD_C  B(2)

      $GEODAT SPRING CONT = FUNCTION
         GD_NL_K  1

      $ELPROP
          M    GEODAT = GD_M
          C    GEODAT = GD_C
          NL_K GEODAT = GD_NL_K   
 
   $END SYSTEM
!
   $SYSTEM NAME = S_STEP_3

      $GEODAT MASS CONT = MASS
         GD_M  1.0

      $GEODAT DAMPER CONT = DAMP
         GD_C  B(3)

      $GEODAT SPRING CONT = FUNCTION
         GD_NL_K  1

      $ELPROP
          M    GEODAT = GD_M
          C    GEODAT = GD_C
          NL_K GEODAT = GD_NL_K   
 
   $END SYSTEM

   $CONSTRAINTS NAME = C_STEP_1
  
       $SUPPRESS DOFS = 2,3
         ALL_NODES
 
       $SUPPRESS  DOFS = 1
         GROUND

   $END CONSTRAINTS

   $LOADING NAME = L_STEP_1

     $CONLOAD LPAT = 1
         101 1: 1.0

     $FREQLOAD 
         LPAT = 1 TYPE = COSINE HARMONIC = 1
 
   $END LOADING

   $RESULTS NAME = R_STEP_1

      $FREQUENCY PRIMARY = EQUI XTYPE = OMEGA
          0.0  2.5 0.01

   $END RESULTS  
$EXIT COMPONENT
$ENTER FUNCTION
!
!   nonlinear part of Equation (32)
!
    $FUNCTION FORMULA LABEL = 1 DESCRIPTION = 'regularized nonlinearity'
      F(X) = 4*K(1)*(X^2+EPS(1))^0.25*X/3 -4*K(1)*(X^2+EPS(1))^0.75*X/30.

$EXIT FUNCTION
$FIN