NEW

INPUT
    READ PERMAS FILE = gengxiang.dat
RETURN

TASK
EXEC
    ACT SIT = STEP_1 ! Free-Free
    VIBRATION ANALYSIS MODES = 10
PRINT
    PORT RES REPLACE FILE = natural_frequencies.txt
    TEXT = 'Free-Free'
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes_1
EXEC
    ACT SIT = STEP_2 ! Simply-supported
    VIBRATION ANALYSIS MODES = 10
PRINT
    PORT RES SWITCH TO FILE = natural_frequencies.txt
    TEXT = 'Simply-supported'
    DATA OBJECT RVALTAB.DISP
    PORT RES RESET
EXPORT
    ITEM MODL
    GO PERMAS BINARY FILE = normal_modes_2
TASK END
STOP