DEFAULT SET TOPOVAR = NODAL

NEW

INPUT
    READ PERMAS FILE = xu.dat
    READ PERMAS FILE = xu_to.dat
RETURN

TASK LOOPS = 100
EXEC
    ACT SIT = STEP_1
    STATIC
    GEN MAXIMUM STRESS MISES SOURCE = INT_PTS APPROX = PNORM EXPONENT = 8.0 ESET = DESIGN
    ACT SIT = TOPO
    TOPO METHOD = ACP
EXPORT
    ITEM CLEAR
    ITEM EFRATIO
    GO PERMAS BINARY FILE = 'efratio_%.3(tloop)'
    ITEM CLEAR
    ITEM XYDATA TYPE = OHIS
    ITEM XYDATA TYPE = CHIS
    ITEM XYDATA TYPE = RHIS
    GO PERMAS BINARY FILE = 'xy_xy_%.3(tloop)'
TASK END
STOP